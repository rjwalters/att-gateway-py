# Copy to .env and fill in. .env is gitignored — never commit real values.

# Gateway LAN address (default for AT&T ARRIS gateways)
ATT_GATEWAY_HOST=192.168.1.254

# Device Access Code — printed on the sticker on the gateway.
# On the CGW452 it looks like "12@34567/8".
ATT_GATEWAY_ACCESS_CODE=

# The gateway uses a self-signed TLS cert; verification is off by default.
# Set to 1 only if you have installed the gateway's cert.
ATT_GATEWAY_VERIFY_TLS=0
